{
  "name": "simochee.net",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro:check": "astro check",
    "schema": "node scripts/schema.ts",
    "prepare": "astro sync",
    "preview": "astro build && astro preview",
    "deploy": "cf deploy",
    "deploy:preview": "rm -rf dist/preview && mkdir -p dist && cp -R .cloudflare/output/v1/workers/default/assets dist/preview && cf deploy --mode preview dist/preview",
    "unfurl": "node scripts/unfurl.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@shikijs/transformers": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "gray-matter": "4.0.3",
    "htmlparser2": "12.0.0",
    "jose": "6.1.3",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "cf": "1.0.0-rc.1",
    "typescript": "6.0.3",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
