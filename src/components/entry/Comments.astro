---
import Plugin from "../layout/Plugin.astro";
import Button from "../ui/Button.astro";
import Disclosure from "../ui/Disclosure.astro";
import TextField from "../ui/TextField.astro";

interface Props {
  slug: string;
}
---

<Plugin title="コメント" class="mt-22" id="comments">
  <post-comments data-slug={Astro.props.slug}>
    <div data-slot="list"></div>
    <p class="px-6 py-8" data-slot="message">コメントを読み込んでいます…</p>
    <template>
      <article class="border-b border-dotted border-line px-6 py-8">
        <h3 class="font-bold text-ink-strong before:content-['■_']" data-slot="title"></h3>
        <p class="mt-2 mb-4 whitespace-pre-line" data-slot="body"></p>
        <p class="type-small text-right text-ink-soft">
          <time data-slot="time"></time>
          <span data-slot="link">
            {" | "}
            <a rel="nofollow ugc noopener">URL</a>
          </span>
          {" | "}
          <span data-slot="name"></span><span class="ml-2 type-small text-memo-ink" data-slot="admin">［管理人］</span>
        </p>
        <Disclosure class="type-small mt-2" label="削除" icon="edit" data-slot="delete">
          <form class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-4 border border-line bg-wash px-8 py-6">
            <label class="flex items-center gap-8">削除パスワード<TextField class="w-160" type="password" name="password" autocomplete="off" required /></label>
            <Button class="px-12 py-1" type="submit">削除する</Button>
            <p class="basis-full" role="alert" data-slot="error" hidden></p>
          </form>
        </Disclosure>
      </article>
    </template>
  </post-comments>
  <noscript><p class="px-6 py-8">コメントを読むには、JavaScript を有効にしてください。</p></noscript>
</Plugin>

<script>
  import type { CommentThread, PublicComment } from "../../lib/api";
  import { commentAnchor } from "../../lib/comments";
  import { formatTimestamp } from "../../lib/dates";
  import { ApiError, call } from "../../scripts/api";
  import { commentsChanged } from "../../scripts/events";
  import { refreshSidebar } from "../../scripts/shared-data";
  import { report, stamp, textFields } from "../../scripts/template";

  customElements.define(
    "post-comments",
    class extends HTMLElement {
      get #slug() {
        return this.dataset.slug!;
      }
      #slot(name: string) {
        return this.querySelector<HTMLElement>(`:scope > [data-slot="${name}"]`)!;
      }

      connectedCallback() {
        document.addEventListener(commentsChanged, this);
        this.addEventListener("submit", this);
        void this.load();
      }
      disconnectedCallback() {
        document.removeEventListener(commentsChanged, this);
      }

      async load(focus?: number) {
        try {
          const { comments } = await call<CommentThread>(
            `/api/comments/?slug=${encodeURIComponent(this.#slug)}`,
          );
          this.#render(comments);
          const target = focus
            ? this.querySelector(`[data-id="${focus}"]`)
            : location.hash.startsWith("#comment-")
              ? document.getElementById(location.hash.slice(1))
              : null;
          target?.scrollIntoView({ block: "start" });
        } catch (error) {
          this.#slot("message").textContent =
            error instanceof ApiError ? error.message : "コメントを読み込めませんでした。";
        }
      }

      #render(comments: PublicComment[]) {
        const template = this.querySelector("template")!;
        this.#slot("list").replaceChildren(
          ...comments.map((comment) => {
            const { fragment, slot } = stamp(template);
            const article = fragment.querySelector("article")!;
            article.id = commentAnchor(comment.number);
            article.dataset.id = String(comment.id);
            slot("title").textContent = comment.title;
            slot("body").textContent = comment.body;
            slot<HTMLTimeElement>("time").dateTime = comment.at;
            slot("time").textContent = formatTimestamp(new Date(comment.at));
            if (comment.url) slot("link").querySelector("a")!.href = comment.url;
            else slot("link").remove();
            slot("name").textContent = comment.name;
            if (!comment.admin) slot("admin").remove();
            if (!comment.deletable) slot("delete").remove();
            return fragment;
          }),
        );
        const message = this.#slot("message");
        message.textContent = "コメントはまだありません。";
        message.hidden = comments.length > 0;
      }

      handleEvent(event: Event) {
        if (event.type === commentsChanged) {
          void this.load((event as CustomEvent<number>).detail);
          return;
        }
        event.preventDefault();
        const remover = event.target as HTMLFormElement;
        void this.#remove(remover.closest<HTMLElement>("article")!, remover);
      }

      async #remove(article: HTMLElement, remover: HTMLFormElement) {
        try {
          await call(`/api/comments/${article.dataset.id}/`, {
            method: "DELETE",
            body: { password: textFields(remover).password },
          });
          document.dispatchEvent(new CustomEvent(commentsChanged));
          refreshSidebar();
        } catch (error) {
          report(
            remover.querySelector<HTMLElement>("[data-slot=error]")!,
            error instanceof ApiError ? error.message : "削除できませんでした。",
            "error",
          );
        }
      }
    },
  );
</script>
