---
import { postPath } from "../../lib/archive";
import type { Post } from "../../lib/posts";
import { formatDay } from "../../lib/dates";

interface Props {
  posts: Post[];
  /** 記事の右に添える小さな注記。文字列でもマークアップでもよい。 */
  note: (post: Post) => unknown;
}
const { posts, note } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li class="flex flex-wrap items-baseline gap-x-10 border-b border-dotted border-line px-4 py-3">
        <time class="type-small text-ink-soft" datetime={post.data.publishedAt.toISOString()}>
          {formatDay(post.data.publishedAt).slice(0, 10)}
        </time>
        <a class="min-w-0 flex-[1_1_14em]" href={postPath(post.id)}>{post.data.title}</a>
        <span class="type-small text-ink-soft">{note(post)}</span>
      </li>
    ))
  }
</ul>
