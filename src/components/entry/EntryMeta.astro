---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import type { Post } from "../../lib/posts";
import { formatDay } from "../../lib/dates";
import { tagPath } from "../../lib/tags";
import { categories } from "../../site";

interface Props {
  post: Post;
}
const { id, data } = Astro.props.post;
---

<footer class="type-small border-t border-line-soft pt-5 text-right text-ink-soft">
  <p>
    <Icon name="folder" /> カテゴリ：<a href={`/${data.type}/`}>{categories[data.type]}</a>
    {
      data.updatedAt && (
        <>
          {" | "}
          <Icon name="clock" /> 更新：
          <time datetime={data.updatedAt.toISOString()}>{formatDay(data.updatedAt)}</time>
        </>
      )
    }
    <share-button hidden data-title={data.title} data-url={`/posts/${id}/`}>
      {" | "}
      <Icon name="share" />
      <Button variant="link" aria-label={`「${data.title}」を共有する`}>共有する</Button>
    </share-button>
  </p>
  {
    data.tags.length > 0 && (
      <p>
        タグ：
        {data.tags.map((tag, index) => (
          <>
            {index > 0 && " , "}
            <a href={tagPath(tag)} rel="tag">{tag}</a>
          </>
        ))}
      </p>
    )
  }
</footer>
