---
import Button from "../ui/Button.astro";
---

<div class="p-8">
<div class="flex items-end gap-8 min-h-60 p-6 bg-wash border border-line">
<span class="pet-sprite" role="img" aria-label="マスコットのおもち"></span>
<div class="type-small relative py-4 px-6 bg-paper border border-frame">こんにちは！ おもちだよ。</div>
</div>
<div class="type-small mt-4">なかよし度 <span class="text-[#a0456b]">■■■□□□□□□□</span><br />おなか <span class="text-[#7a4a1e]">●●○○○</span></div>
<div class="flex gap-4 mt-4">
<Button class="type-small flex-[1_1_0] py-1">なでる</Button>
<Button class="type-small flex-[1_1_0] py-1">ごはん</Button>
<Button class="type-small flex-[1_1_0] py-1">あそぶ</Button>
</div>
</div>
