---
import Icon from "../ui/Icon.astro";

// デザインに書かれていた見本のデータ。実データにつなぐときに置き換える。
const mastoPosts = [
  {text: "古本屋で探していた文庫を発見。うれしい。", time: "1時間前"},
  {text: "銀杏並木がまっ黄色でした。", time: "2日前"},
];
---

<div class="py-6 px-8">
<div class="type-small"><Icon name="mastodon" /> <a href="#">@simochee@（サーバー未定）</a></div>
{mastoPosts.map((p) => (
<div class="py-3 border-b border-dotted border-line">{p.text}<br /><span class="type-small text-ink-soft">{p.time}</span></div>
))}
</div>
