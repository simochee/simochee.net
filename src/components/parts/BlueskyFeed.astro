---
import Icon from "../ui/Icon.astro";

// デザインに書かれていた見本のデータ。実データにつなぐときに置き換える。
const bskyPosts = [
  {text: "喫茶店のプリン、また新しいお店を見つけた。週末に行く。", time: "2時間前"},
  {text: "ブログ更新しました。モーニングの話です。", time: "5時間前"},
  {text: "こたつ出した。もう出られない。", time: "昨日"},
];
---

<div class="py-6 px-8">
<div class="type-small"><Icon name="bsky" /> <a href="#">@simochee.net</a></div>
{bskyPosts.map((p) => (
<div class="py-3 border-b border-dotted border-line">{p.text}<br /><span class="type-small text-ink-soft">{p.time}</span></div>
))}
</div>
