---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts";
import { formatDay } from "../lib/dates";
import EntryMeta from "./EntryMeta.astro";

interface Props {
  post: Post;
}
const { post } = Astro.props;
const href = `/posts/${post.id}/`;
---

<article class="entry">
  <p class="entry-date small">
    <time datetime={post.data.publishedAt.toISOString()}>{formatDay(post.data.publishedAt)}</time>
    {post.data.status === "draft" && " ［下書き］"}
  </p>
  <h2 class="entry-title" transition:name={`entry-${post.id}`}><a href={href}>{post.data.title}</a></h2>
  <div class="entry-body">
    {
      post.data.thumbnail && (
        <Image class="entry-photo" src={post.data.thumbnail} alt="" width={240} height={160} fit="cover" densities={[1, 2]} format="webp" loading="lazy" />
      )
    }
    <p>{post.data.description}</p>
  </div>
  <p class="entry-more"><a href={href} aria-label={`「${post.data.title}」の続きを読む`}>続きを読む &raquo;</a></p>
  <EntryMeta post={post} />
</article>
