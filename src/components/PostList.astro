---
import { Image } from 'astro:assets';
import { type Post, formatDate, year } from '../lib/posts';
import { categories } from '../site';
interface Props { posts: Post[] }
const groups = Map.groupBy(Astro.props.posts, (post) => year(post.data.publishedAt));
---
{[...groups].map(([groupYear, posts]) => <section><h2>{groupYear}</h2><ul class="post-list">{posts.map((post) => {
  const thumbnail = post.data.thumbnail;
  return <li>
    {thumbnail && <a href={`/posts/${post.id}/`} aria-label={post.data.title}><Image src={thumbnail} alt="" widths={[320, 640]} sizes="(max-width: 600px) 100vw, 240px" width={640} format="webp" loading="lazy" /></a>}
    <div><p class="metadata"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time> · {categories[post.data.type]}{post.data.status === 'draft' && ' · 下書き'}</p><h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
  </li>;
})}</ul></section>)}
{Astro.props.posts.length === 0 && <p>記事はまだありません。</p>}
