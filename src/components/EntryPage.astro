---
import type { Post } from "../lib/posts";
import { pageCount, pageOf, pagePath } from "../lib/paging";
import EntryList from "./EntryList.astro";
import Pager from "./Pager.astro";

interface Props {
  posts: Post[];
  page: number;
}
const { posts, page } = Astro.props;
const last = pageCount(posts.length);
---

<EntryList posts={pageOf(posts, page)} />
{posts.length === 0 && <p>記事はまだありません。</p>}
<Pager
  label="ページ送り"
  newer={page > 1 ? { href: pagePath(page - 1), label: "新しい記事" } : undefined}
  older={page < last ? { href: pagePath(page + 1), label: "古い記事" } : undefined}
/>
