import RecentCommentsPlugin from "../plugins/RecentCommentsPlugin.astro";
import PopularPlugin from "../plugins/PopularPlugin.astro";
import SearchPlugin from "../plugins/SearchPlugin.astro";
import BoardPlugin from "../plugins/BoardPlugin.astro";
import PollPlugin from "../plugins/PollPlugin.astro";
import QrPlugin from "../plugins/QrPlugin.astro";
import ViewersPlugin from "../plugins/ViewersPlugin.astro";
import CounterPlugin from "../plugins/CounterPlugin.astro";
import ArchivePlugin from "../plugins/ArchivePlugin.astro";
import CategoryPlugin from "../plugins/CategoryPlugin.astro";
import FeedPlugin from "../plugins/FeedPlugin.astro";
import LinksPlugin from "../plugins/LinksPlugin.astro";
import ThemePlugin from "../plugins/ThemePlugin.astro";
import AllEntriesPlugin from "../plugins/AllEntriesPlugin.astro";
import { hasServer } from "../../lib/features";
---

<ProfilePlugin />
<CalendarPlugin />
<MoonPlugin />
<RecentPlugin />
{hasServer && <RecentCommentsPlugin />}
{hasServer && <PopularPlugin />}
<ArchivePlugin />
<CategoryPlugin />
<SearchPlugin />
