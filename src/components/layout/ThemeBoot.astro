---
import { themes } from "../../lib/themes";

const allowed = themes.map((theme) => theme.id);
---

{/* 外部ファイルにすると読み込みを待つあいだ既定の色で描かれ、選んだ色へ切り替わる瞬間が見えてしまう。 */}
<script is:inline define:vars={{ allowed }}>
  const applyFont = (doc, url) => {
    const forced = url.searchParams.get("font") === "system";
    let saved = null;
    try {
      if (forced) localStorage.setItem("font", "system");
      saved = localStorage.getItem("font");
    } catch {}
    if (forced || saved === "system") doc.documentElement.dataset.font = "system";
  };
  const applyTheme = (doc) => {
    try {
      const theme = localStorage.getItem("theme");
      if (!allowed.includes(theme)) return;
      doc.documentElement.dataset.theme = theme;
      doc.querySelector('link[rel="icon"][type="image/svg+xml"]')?.setAttribute("href", `/favicon/${theme}.svg`);
    } catch {}
  };
  applyFont(document, new URL(location.href));
  applyTheme(document);
  // ページ遷移では html 要素の属性も次のページのものへ置き換わる。差し替える前の文書に付けておけば、既定の色が一瞬見えることもない。
  document.addEventListener("astro:before-swap", (event) => {
    applyFont(event.newDocument, event.to);
    applyTheme(event.newDocument);
  });
</script>
