---
import { encode } from "uqr";
import Plugin from "../layout/Plugin.astro";

const rows = encode(new URL("/", Astro.site).href, { border: 4 }).data;
---

<Plugin title="QRコード">
  <div class="px-4 py-8">
    <div class="inline-flex flex-col border border-line bg-paper" role="img" aria-label="このブログのQRコード">
      {rows.map((row) => <div class="flex">{row.map((on) => <span class:list={["block size-4", on ? "bg-lcd" : "bg-paper"]} />)}</div>)}
    </div>
  </div>
</Plugin>
