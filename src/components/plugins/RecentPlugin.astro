---
import Plugin from "../Plugin.astro";
import { formatMonthDay } from "../../lib/dates";
import { posts } from "../../lib/posts";

const recent = (await posts()).slice(0, 5);
---

{
  recent.length > 0 && (
    <Plugin title="最新記事">
      <ul>
        {recent.map((post) => (
          <li>
            ・<a href={`/posts/${post.id}/`}>{post.data.title}</a> ({formatMonthDay(post.data.publishedAt)})
          </li>
        ))}
      </ul>
    </Plugin>
  )
}
