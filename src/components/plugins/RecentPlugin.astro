---
import Plugin from "../layout/Plugin.astro";
import PluginList from "../layout/PluginList.astro";
import { postPath } from "../../lib/archive";
import { formatMonthDay } from "../../lib/dates";
import { posts } from "../../lib/posts";

const recent = (await posts()).slice(0, 5);
---

{
  recent.length > 0 && (
    <Plugin title="最新記事">
      <PluginList>
        {recent.map((post) => (
          <li class="bullet">
            <a href={postPath(post.id)}>{post.data.title}</a> ({formatMonthDay(post.data.publishedAt)})
          </li>
        ))}
      </PluginList>
    </Plugin>
  )
}
