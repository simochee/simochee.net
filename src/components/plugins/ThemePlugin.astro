---
import Plugin from "../Plugin.astro";
import { themes } from "../../lib/themes";
---

<theme-picker hidden>
  <Plugin title="着せかえ">
    <div class="px-4 py-8">
      <div class="flex flex-wrap gap-4" role="group" aria-label="テンプレートの色">
        {
          themes.map((theme) => (
            <button type="button" class="h-20 w-30 cursor-pointer border border-frame bg-paper p-2 aria-pressed:border-2 aria-pressed:border-ink-strong aria-pressed:p-1" data-theme-choice={theme.id} aria-pressed="false" aria-label={theme.name} title={theme.name}>
              <span class="block h-full" style={`background: ${theme.color}`} />
            </button>
          ))
        }
      </div>
      <p class="type-small mt-4">
        いまの色：<span data-theme-name></span>
        <span data-theme-reset hidden>
          | <button type="button" class="cursor-pointer text-link underline hover:text-link-hover" data-theme-choice="">もとにもどす</button>
        </span>
      </p>
    </div>
  </Plugin>
</theme-picker>

<script>
  import { themes } from "../../lib/themes";

  const key = "theme";
  const save = (theme: string) => {
    try {
      if (theme) localStorage.setItem(key, theme);
      else localStorage.removeItem(key);
    } catch {
      // 保存できない環境（プライベートブラウズなど）でも、このページの見た目は変わる。
    }
  };

  customElements.define(
    "theme-picker",
    class extends HTMLElement {
      connectedCallback() {
        this.addEventListener("click", this);
        this.hidden = false;
        this.reflect();
      }
      handleEvent(event: Event) {
        const choice = (event.target as Element).closest("button")?.dataset.themeChoice;
        if (choice === undefined) return;
        if (choice) document.documentElement.dataset.theme = choice;
        else delete document.documentElement.dataset.theme;
        save(choice);
        this.reflect();
      }
      reflect() {
        const chosen = document.documentElement.dataset.theme;
        const theme = themes.find((item) => item.id === chosen) ?? themes[0];
        for (const button of this.querySelectorAll<HTMLElement>("[aria-pressed]"))
          button.setAttribute("aria-pressed", String(button.dataset.themeChoice === theme.id));
        this.querySelector("[data-theme-name]")!.textContent = theme.name;
        this.querySelector<HTMLElement>("[data-theme-reset]")!.hidden = !chosen;
      }
    },
  );
</script>
