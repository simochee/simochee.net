---
import Plugin from "../Plugin.astro";
import { fonts, themes } from "../../lib/themes";
---

<theme-picker hidden>
  <Plugin title="着せかえ">
    <div class="flex flex-col gap-4 px-4 py-8">
      <div class="flex flex-wrap gap-4" role="group" aria-label="テンプレートの色">
        {
          themes.map((theme) => (
            <button type="button" class="h-24 w-30 cursor-pointer border border-frame bg-paper p-2 aria-pressed:border-2 aria-pressed:border-ink-strong aria-pressed:p-1" data-theme-choice={theme.id} aria-pressed="false" aria-label={theme.name} title={theme.name}>
              <span class="block h-full" style={`background: ${theme.color}`} />
            </button>
          ))
        }
      </div>
      <p class="type-small">いまの色：<span data-theme-name></span></p>
      <div class="type-small flex flex-wrap gap-x-8 gap-y-4" role="group" aria-label="文字の見た目">
        {
          fonts.map((font) => (
            <button type="button" class="cursor-pointer text-link underline hover:text-link-hover aria-pressed:font-bold aria-pressed:text-ink aria-pressed:no-underline aria-pressed:before:content-['▶']" data-font-choice={font.id} aria-pressed="false">
              {font.name}
            </button>
          ))
        }
      </div>
    </div>
  </Plugin>
</theme-picker>

<script>
  import { fonts, themes } from "../../lib/themes";

  const read = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // 保存できない環境（プライベートブラウズなど）でも、このページの見た目は変わる。
    }
  };

  customElements.define(
    "theme-picker",
    class extends HTMLElement {
      connectedCallback() {
        this.addEventListener("click", this);
        this.hidden = false;
        this.reflect();
      }
      handleEvent(event: Event) {
        const button = (event.target as Element).closest("button");
        if (!button) return;
        const { themeChoice, fontChoice } = button.dataset;
        if (themeChoice) {
          document.documentElement.dataset.theme = themeChoice;
          write("theme", themeChoice);
        }
        if (fontChoice) {
          document.documentElement.dataset.font = fontChoice;
          write("font", fontChoice);
        }
        this.reflect();
      }
      reflect() {
        const theme = document.documentElement.dataset.theme ?? read("theme") ?? themes[0].id;
        const font = document.documentElement.dataset.font ?? read("font") ?? fonts[0].id;
        for (const button of this.querySelectorAll("button")) {
          const { themeChoice, fontChoice } = button.dataset;
          button.setAttribute("aria-pressed", String(themeChoice === theme || fontChoice === font));
        }
        this.querySelector("[data-theme-name]")!.textContent =
          themes.find((item) => item.id === theme)?.name ?? themes[0].name;
      }
    },
  );
</script>
