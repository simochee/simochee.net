---
import Plugin from "../layout/Plugin.astro";
import { themes } from "../../lib/themes";
---

<theme-picker hidden>
  <Plugin title="着せかえ">
    <div class="px-4 py-8">
      <div class="flex flex-wrap gap-4" role="group" aria-label="テンプレートの色">
        {
          themes.map((theme) => (
            <button type="button" class="h-20 w-30 cursor-pointer border border-frame bg-paper p-2 aria-pressed:border-2 aria-pressed:border-ink-strong aria-pressed:p-1" data-theme-choice={theme.id} aria-pressed="false" aria-label={theme.name} title={theme.name}>
              <span class="block h-full border border-line" style={`background: ${theme.color}`} />
            </button>
          ))
        }
      </div>
    </div>
  </Plugin>
</theme-picker>

<script>
  import { defaultTheme, themes } from "../../lib/themes";

  const key = "theme";
  const save = (theme: string) => {
    try {
      localStorage.setItem(key, theme);
    } catch {
      // 保存できない環境（プライベートブラウズなど）でも、このページの見た目は変わる。
    }
  };

  customElements.define(
    "theme-picker",
    class extends HTMLElement {
      connectedCallback() {
        this.addEventListener("click", this);
        this.hidden = false;
        this.reflect();
      }
      handleEvent(event: Event) {
        const choice = (event.target as Element).closest("button")?.dataset.themeChoice;
        if (!choice) return;
        document.documentElement.dataset.theme = choice;
        document.querySelector('link[rel="icon"][type="image/svg+xml"]')?.setAttribute("href", `/favicon/${choice}.svg`);
        save(choice);
        this.reflect();
      }
      reflect() {
        const theme = themes.find((item) => item.id === document.documentElement.dataset.theme) ?? defaultTheme;
        for (const button of this.querySelectorAll<HTMLElement>("[aria-pressed]"))
          button.ariaPressed = String(button.dataset.themeChoice === theme.id);
      }
    },
  );
</script>
