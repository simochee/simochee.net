---
import Plugin from "../layout/Plugin.astro";
import PluginList from "../layout/PluginList.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../lib/comments";
---

<recent-comments hidden>
  <Plugin title="最新コメント">
    <PluginList />
    <template>
      <li>
        ・{Object.entries(services).map(([via, name]) => <span data-via={via}><Icon name={via} label={`${name}から`} class="mr-2" /></span>)}<span data-slot="name"></span>：<a data-slot="post"></a> (<span data-slot="date"></span>)
      </li>
    </template>
  </Plugin>
</recent-comments>

<script>
  import { commentAnchor } from "../../lib/comments";
  import { formatMonthDay } from "../../lib/dates";
  import { onSidebar } from "../../scripts/shared-data";
  import { stamp } from "../../scripts/template";

  customElements.define(
    "recent-comments",
    class extends HTMLElement {
      connectedCallback() {
        onSidebar(({ comments }) => {
          const template = this.querySelector("template")!;
          this.querySelector("ul")!.replaceChildren(
            ...comments.map((comment) => {
              const { fragment, slot } = stamp(template);
              for (const icon of fragment.querySelectorAll<HTMLElement>("[data-via]"))
                if (icon.dataset.via !== comment.via) icon.remove();
              slot("name").textContent = comment.name;
              slot<HTMLAnchorElement>("post").href = `/posts/${comment.slug}/#${commentAnchor(comment.number)}`;
              slot("post").textContent = comment.postTitle;
              slot("date").textContent = formatMonthDay(new Date(comment.at));
              return fragment;
            }),
          );
          this.hidden = comments.length === 0;
        });
      }
    },
  );
</script>
