---
import Plugin from "../layout/Plugin.astro";
import PluginList from "../layout/PluginList.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../content/comment-schema";
import { threads } from "../../lib/comment-store";
import { commentAnchor, recentComments } from "../../lib/comments";
import { formatMonthDay } from "../../lib/dates";
import { posts } from "../../lib/posts";

const titles = new Map((await posts()).map((post) => [post.id, post.data.title]));
const recent = recentComments(await threads(), 5);
---

{
  recent.length > 0 && (
    <Plugin title="最新コメント">
      <PluginList>
        {recent.map(({ slug, number, comment }) => (
          <li>
            ・{comment.via && <Icon name={comment.via} label={`${services[comment.via]}から`} class="mr-2" />}
            {comment.name}：<a href={`/posts/${slug}/#${commentAnchor(number)}`}>{titles.get(slug)}</a> ({formatMonthDay(comment.at)})
          </li>
        ))}
      </PluginList>
    </Plugin>
  )
}
