---
import Plugin from "../layout/Plugin.astro";
import PluginList from "../layout/PluginList.astro";
import { site } from "../../site";
---

<Plugin title="リンク">
  <PluginList>
    {
      site.links.map((link) => (
        <li class="bullet">
          <a href={link.href} rel="me noopener">{link.label}</a> <span class="type-small text-ink-soft">（{link.note}）</span>
        </li>
      ))
    }
  </PluginList>
</Plugin>
