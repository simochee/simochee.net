---
import Plugin from "../Plugin.astro";
import { site } from "../../site";
---

<Plugin title="リンク">
  <ul>
    {
      site.links.map((link) => (
        <li>
          ・<a href={link.href} rel="me noopener">{link.label}</a> <span class="small note">（{link.note}）</span>
        </li>
      ))
    }
  </ul>
</Plugin>
