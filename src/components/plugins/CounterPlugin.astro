---
import Plugin from "../layout/Plugin.astro";
---

<access-counter hidden>
  <Plugin title="アクセスカウンター">
    <div class="group relative px-4 py-8 text-center">
      <div class="inline-flex gap-2" tabindex="0" aria-describedby="access-counter-week" data-counter="digits"></div>
      <div
        id="access-counter-week"
        role="tooltip"
        class="absolute top-full left-1/2 z-10 -mt-4 hidden -translate-x-1/2 border border-frame bg-paper px-10 py-8 text-left group-focus-within:block group-hover:block"
      >
        <p class="type-small whitespace-nowrap">この 1 週間：<b data-counter="week-total"></b> 人</p>
        <ol class="mt-6 flex items-end gap-4 border-b border-line" data-counter="bars"></ol>
        <ol class="type-small mt-2 flex gap-4" aria-hidden="true" data-counter="weekdays"></ol>
      </div>
    </div>
  </Plugin>
</access-counter>

<script>
  import type { CounterStats } from "../../lib/counter";

  const digitCount = 7;
  const barHeight = 48;
  const weekdays = ["日", "月", "火", "水", "木", "金", "土"];

  function element(tag: string, className: string, text = "") {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    return node;
  }

  customElements.define(
    "access-counter",
    class extends HTMLElement {
      #requested = false;

      async connectedCallback() {
        // サイドバーはページ遷移をまたいで付け替えられ、そのたびに呼ばれる。数字は 10 分ごとにしか変わらないので、読むのは最初の 1 回だけ。
        if (this.#requested) return;
        this.#requested = true;
        const response = await fetch("/api/counter/").catch(() => undefined);
        if (!response?.ok) return;
        this.#render((await response.json()) as CounterStats);
        this.hidden = false;
      }

      #part(name: string) {
        return this.querySelector(`[data-counter="${name}"]`)!;
      }

      #render({ total, week }: CounterStats) {
        const digits = this.#part("digits");
        digits.setAttribute("aria-label", `累計 ${total.toLocaleString("ja-JP")} 人`);
        digits.replaceChildren(
          ...[...String(total).padStart(digitCount, "0")].map((digit) =>
            element("span", "inline-block w-14 bg-lcd py-1 font-bold text-lcd-ink", digit),
          ),
        );

        this.#part("week-total").textContent = week
          .reduce((sum, entry) => sum + entry.visits, 0)
          .toLocaleString("ja-JP");

        const most = Math.max(1, ...week.map((entry) => entry.visits));
        this.#part("bars").replaceChildren(
          ...week.map(({ day, visits }) => {
            const [, month, date] = day.split("-").map(Number);
            const label = `${month}月${date}日 ${visits} 人`;
            const bar = element("li", "flex h-48 w-16 items-end");
            bar.title = label;
            const fill = element("span", "block w-full bg-accent");
            // 1 人でもいれば、0 人の日と見分けられるよう 1px は残す。
            fill.style.height = `${visits && Math.max(1, Math.round((visits / most) * barHeight))}px`;
            bar.append(fill, element("span", "sr-only", label));
            return bar;
          }),
        );

        this.#part("weekdays").replaceChildren(
          ...week.map(({ day }) => {
            const weekday = new Date(`${day}T00:00:00Z`).getUTCDay();
            const cell = element("li", "w-16 text-center data-[weekday=0]:text-sunday data-[weekday=6]:text-saturday", weekdays[weekday]);
            cell.dataset.weekday = String(weekday);
            return cell;
          }),
        );
      }
    },
  );
</script>
