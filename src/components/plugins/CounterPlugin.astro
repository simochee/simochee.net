---
import Plugin from "../layout/Plugin.astro";
---

<access-counter hidden>
  <Plugin title="アクセスカウンター">
    <div class="px-4 py-8 text-center">
      <div class="inline-flex gap-2" role="img" data-slot="digits"></div>
      <div class="type-small mt-4">あなたは <span data-slot="number"></span> 人目のお客様です</div>
    </div>
  </Plugin>
</access-counter>

<script>
  import { counterDigits } from "../../lib/counter";
  import { onVisit } from "../../scripts/visit";

  customElements.define(
    "access-counter",
    class extends HTMLElement {
      connectedCallback() {
        const slot = (name: string) => this.querySelector<HTMLElement>(`[data-slot="${name}"]`)!;
        onVisit(({ number, total }) => {
          slot("digits").setAttribute("aria-label", `これまでのお客様 ${total} 人`);
          slot("digits").replaceChildren(
            ...[...counterDigits(total)].map((digit) =>
              Object.assign(document.createElement("span"), {
                className: "inline-block w-14 bg-lcd py-1 font-bold text-lcd-ink",
                textContent: digit,
              }),
            ),
          );
          slot("number").textContent = counterDigits(number ?? total);
          this.hidden = false;
        });
      }
    },
  );
</script>
