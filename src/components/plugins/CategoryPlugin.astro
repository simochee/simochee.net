---
import Plugin from "../layout/Plugin.astro";
import PluginList from "../layout/PluginList.astro";
import { posts } from "../../lib/posts";
import { categories } from "../../categories";

const all = await posts();
---

<Plugin title="カテゴリ">
  <PluginList>
    {
      Object.entries(categories).map(([type, name]) => (
        <li class="bullet">
          <a href={`/${type}/`}>{name}</a> ({all.filter((post) => post.data.type === type).length})
        </li>
      ))
    }
  </PluginList>
</Plugin>
