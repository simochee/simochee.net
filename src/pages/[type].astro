---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/posts';
export function getStaticPaths() { return ['tech', 'personal'].map((type) => ({ params: { type } })); }
const type = Astro.params.type;
---
<Base title={type === 'tech' ? '技術' : '日々'}><h1>{type === 'tech' ? '技術' : '日々'}</h1><PostList posts={(await posts()).filter((post) => post.data.type === type)} /></Base>
