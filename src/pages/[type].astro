---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/posts';
import { categories, type Category } from '../site';
export function getStaticPaths() { return Object.keys(categories).map((type) => ({ params: { type } })); }
const type = Astro.params.type as Category;
---
<Base title={categories[type]}><h1 class="page-title">■ カテゴリ「{categories[type]}」の記事一覧</h1><PostList posts={(await posts()).filter((post) => post.data.type === type)} /></Base>
