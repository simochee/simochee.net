---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { site } from "../site";
---

<Base title="プロフィール" description={`管理人${site.author.name}のことと、このブログのこと。`}>
  <h1 class="title-box mb-12">プロフィール</h1>
  <div class="mb-18 flex flex-wrap items-start gap-14">
    <Avatar size={120} />
    <table class="type-small flex-[1_1_280px] border-collapse">
      <tbody>
        <tr><th class="w-[9em] border border-line bg-tint px-8 py-3 text-left font-bold whitespace-nowrap" scope="row">なまえ</th><td class="border border-line px-8 py-3">{site.author.name}（{site.author.id}）</td></tr>
        <tr><th class="w-[9em] border border-line bg-tint px-8 py-3 text-left font-bold whitespace-nowrap" scope="row">かいていること</th><td class="border border-line px-8 py-3">{site.author.bio}</td></tr>
        <tr><th class="w-[9em] border border-line bg-tint px-8 py-3 text-left font-bold whitespace-nowrap" scope="row">ひとこと</th><td class="border border-line px-8 py-3">{site.author.message}</td></tr>
      </tbody>
    </table>
  </div>
  <div class="prose">
    <h2>ごあいさつ</h2>
    <p>
      はじめまして、{site.author.name}です。<br />
      このブログには、技術のこと、写真のこと、日々のことを、数行のメモからながめの解説まで書いていきます。<br />
      どうぞのんびりしていってください。
    </p>
    <h2>ほかの場所でも</h2>
    <ul>
      {
        site.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">{link.label}</a>（{link.note}）
          </li>
        ))
      }
      <li><span class="ico ico-rss" aria-hidden="true"></span> RSS：<a href="/feed.xml">{new URL("/feed.xml", Astro.site)}</a></li>
    </ul>
  </div>
</Base>
