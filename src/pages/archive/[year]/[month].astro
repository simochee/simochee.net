---
import Base from "../../../layouts/Base.astro";
import EntryList from "../../../components/EntryList.astro";
import ListHeader from "../../../components/ListHeader.astro";
import Pager from "../../../components/Pager.astro";
import { groupByMonth } from "../../../lib/archive";
import { posts } from "../../../lib/posts";

export async function getStaticPaths() {
  const months = groupByMonth(await posts());
  return months.map((month, index) => ({
    params: { year: month.year, month: month.month },
    props: { month, newer: months[index - 1], older: months[index + 1] },
  }));
}
const { month, newer, older } = Astro.props;
const link = (target?: typeof month) => target && { href: target.path, label: target.label };
---

<Base title={`${month.label}の記事`}>
  <ListHeader crumbs={["月別アーカイブ", month.label]} heading={`${month.label}の記事一覧`} count={month.posts.length} />
  <EntryList posts={month.posts} />
  <Pager label="前後の月" newer={link(newer)} older={link(older)} />
</Base>
