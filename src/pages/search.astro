---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import TextField from "../components/ui/TextField.astro";
---

<Base title="検索結果">
  <nav class="type-small mb-6 text-ink-soft" aria-label="現在位置"><a href="/">ホーム</a> &gt; 検索結果</nav>

  <search-results>
    <div class="mb-16 border border-line bg-wash px-10 py-6">
      <h1 class="font-bold text-ink-strong" data-heading>検索</h1>
      <p class="type-small text-ink-soft" data-summary aria-live="polite"></p>
      <noscript><p class="type-small mt-4 text-ink-soft">検索には JavaScript が必要です。JavaScript を有効にしてお試しください。</p></noscript>

      <form class="mt-6 flex flex-wrap items-center gap-4" action="/search/" method="get" role="search">
        <label class="type-small" for="list-q">キーワード</label>
        <TextField class="min-w-0 flex-[0_1_220px]" id="list-q" type="search" name="q" />
        <Button class="px-10 py-1" type="submit">検索</Button>
        <span class="type-small text-ink-soft">※ 記事のタイトルと本文から探します</span>
      </form>
    </div>

    <div data-results hidden></div>

    <template data-result>
      <article class="mb-22">
        <p class="type-small mb-6 border-b border-dotted border-frame pb-2 text-ink-soft"><time data-date></time></p>
        <h2 class="title-box mb-8"><a data-title></a></h2>
        <p class="mb-6 px-6 leading-prose">
          <span data-before></span><mark class="bg-mark px-1 text-ink" data-hit></mark><span data-after></span> <a data-more>続きを読む &raquo;</a>
        </p>
        <p class="type-small text-right text-ink-soft">
          <Icon name="folder" /> カテゴリ：<a data-category></a>
          {" | "}
          <Icon name="comment" /> <a data-comments>コメント(<comment-count data-slug>-</comment-count>)</a>
        </p>
      </article>
    </template>
  </search-results>
</Base>

<script>
  import "../scripts/search";
</script>
