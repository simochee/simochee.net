---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";

// デザインに書かれていた見本のデータ。実データにつなぐときに置き換える。
const photos = [
  {caption: "モーニングセット", date: "2026/11/18", title: "久しぶりに喫茶店でモーニング", href: "#", selected: true},
  {caption: "窓ぎわの席", date: "2026/11/18", title: "久しぶりに喫茶店でモーニング", href: "#", selected: false},
  {caption: "新しいテンプレート", date: "2026/11/15", title: "テンプレートを変えてみました", href: "#", selected: false},
  {caption: "積ん読の山", date: "2026/11/12", title: "読書メモ：積ん読を崩す冬", href: "#", selected: false},
  {caption: "喫茶店のナポリタン", date: "2026/11/10", title: "このブログで使える書き方まとめ", href: "#", selected: false},
  {caption: "銀杏並木", date: "2026/11/07", title: "近所の公園の銀杏並木", href: "#", selected: false},
  {caption: "足もとの落ち葉", date: "2026/11/07", title: "近所の公園の銀杏並木", href: "#", selected: false},
  {caption: "かぼちゃプリン", date: "2026/10/29", title: "ハロウィンのかぼちゃプリン", href: "#", selected: false},
  {caption: "古本市で見つけた本", date: "2026/10/26", title: "古本市で見つけた料理の本", href: "#", selected: false},
  {caption: "プリン3種", date: "2026/10/21", title: "古い喫茶店のプリンを食べ比べ", href: "#", selected: false},
  {caption: "焼きたてのパン", date: "2026/10/12", title: "秋のパン祭り（自分ちで）", href: "#", selected: false},
  {caption: "コスモス畑", date: "2026/09/27", title: "コスモス畑まで散歩", href: "#", selected: false},
];
---

<Base title="画像一覧">
<h1 class="title-box mb-4">画像一覧</h1>
<p class="type-small mb-10 text-ink-soft">記事にのせた写真を、新しい順に並べています。小さい写真を押すと、上に大きく表示されます。（全 36 枚）</p>

<div class="mb-14 p-10 bg-wash border border-line text-center">
<div class="type-small w-400 max-w-full h-300 mx-auto flex items-center justify-center bg-blank border border-photo text-ink-soft" role="img" aria-label="モーニングセット">[写真：モーニングセット 400×300]</div>
<div class="mt-6 font-bold text-ink-strong">モーニングセット</div>
<div class="type-small text-ink-soft">2026/11/18 の記事「<a href="#">久しぶりに喫茶店でモーニング</a>」より</div>
<div class="flex justify-center items-center gap-10 mt-6">
<Button class="px-10" variant="plain">« 前の写真</Button>
<span class="type-small text-ink-soft">1 / 12</span>
<Button class="px-10" variant="plain">次の写真 »</Button>
</div>
</div>

<div class="grid grid-cols-[repeat(auto-fill,minmax(120px,1fr))] gap-10">
{photos.map((p) => (
<button class="flex min-w-0 cursor-pointer flex-col gap-3 border border-line bg-paper p-4 text-left text-ink aria-pressed:border-2 aria-pressed:border-accent aria-pressed:p-3" type="button" aria-pressed={p.selected}>
<span class="type-small flex items-center justify-center w-full aspect-[4/3] bg-blank text-ink-soft">[写真]</span>
<span class="type-small text-ink-strong">{p.caption}</span>
<span class="type-small text-ink-soft">{p.date}</span>
</button>
))}
</div>

<div class="mt-14 text-center p-4 border-y border-dotted border-frame">« 新しい12枚 | <b>1</b> <a href="#">2</a> <a href="#">3</a> | <a href="#">古い12枚 »</a></div>
</Base>
