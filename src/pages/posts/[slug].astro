---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Clap from "../../components/entry/Clap.astro";
import CommentForm from "../../components/entry/CommentForm.astro";
import Comments from "../../components/entry/Comments.astro";
import EntryMeta from "../../components/entry/EntryMeta.astro";
import Pager from "../../components/entry/Pager.astro";
import { posts } from "../../lib/posts";
import { formatDay } from "../../lib/dates";

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: all[index - 1], older: all[index + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
// 脚注の見出しは remark が足す読み上げ専用のもので、目に見える見出しではない。
const toc = headings.filter((heading) => heading.depth <= 3 && heading.slug !== "footnote-label");
const link = (target?: typeof post) => target && { href: `/posts/${target.id}/`, label: target.data.title };
---

<Base title={post.data.title} description={post.data.description} image={`/og/${post.id}.jpg`} article publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt}>
  <Pager class="mb-12 p-4" label="前後の記事" newer={link(newer)} older={link(older)} />
  <article>
    <p class="type-small mb-6 border-b border-dotted border-frame pb-2 text-ink-soft">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDay(post.data.publishedAt)}</time>
      {post.data.status === "draft" && " ［下書きプレビュー］"}
    </p>
    <h1 class="title-box mb-10">{post.data.title}</h1>
    <div class="prose px-6 leading-prose">
      {
        toc.length > 1 && (
          <nav class="border border-line bg-wash px-12 py-6" aria-label="目次">
            <p class="font-bold text-ink-strong" aria-hidden="true">【もくじ】</p>
            <ol class="mt-2 pl-[1.8em]">
              {toc.map((heading) => (
                <li class:list={{ "ml-[1em] list-['・'] [counter-increment:list-item_0]": heading.depth > 2 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <Content />
    </div>
    <Clap slug={post.id} />
    <EntryMeta post={post} />
  </article>
  <Pager class="mt-16 p-4" label="前後の記事（ページ下）" newer={link(newer)} older={link(older)} />
  <Comments slug={post.id} />
  <CommentForm slug={post.id} />
</Base>
