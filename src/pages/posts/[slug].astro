---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import EntryMeta from "../../components/EntryMeta.astro";
import Pager from "../../components/Pager.astro";
import { posts } from "../../lib/posts";
import { formatDay } from "../../lib/dates";

export async function getStaticPaths() {
  const all = await posts();
  return all.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: all[index - 1], older: all[index + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
// 脚注の見出しは remark が足す読み上げ専用のもので、目に見える見出しではない。
const toc = headings.filter((heading) => heading.depth <= 3 && heading.slug !== "footnote-label");
const link = (target?: typeof post) => target && { href: `/posts/${target.id}/`, label: target.data.title };
---

<Base title={post.data.title} description={post.data.description} image={`/og/${post.id}.jpg`} article publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt}>
  <Pager label="前後の記事" newer={link(newer)} older={link(older)} />
  <article class="entry">
    <p class="entry-date small">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDay(post.data.publishedAt)}</time>
      {post.data.status === "draft" && " ［下書きプレビュー］"}
    </p>
    <h1 class="entry-title" transition:name={`entry-${post.id}`}>{post.data.title}</h1>
    <div class="entry-body prose">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="目次">
            <p class="toc-label" aria-hidden="true">【もくじ】</p>
            <ol>
              {toc.map((heading) => (
                <li class:list={{ sub: heading.depth > 2 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <Content />
    </div>
    <EntryMeta post={post} />
  </article>
  <Pager label="前後の記事（ページ下）" newer={link(newer)} older={link(older)} />
</Base>
