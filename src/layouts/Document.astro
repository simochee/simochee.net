---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import bodyFont from "../assets/fonts/shinonome14-regular-kana.woff2?url";
import ThemeBoot from "../components/layout/ThemeBoot.astro";
import { site } from "../site";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}
const { title, description = site.description, image = "/og.jpg", article, publishedAt, updatedAt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <ThemeBoot />
    <ClientRouter fallback="swap" />
  </head>
  <body class="px-10 pt-14 pb-32">
    <a class="absolute top-0 left-0 -translate-y-[200%] border border-frame bg-paper px-12 py-4 focus:z-10 focus:translate-y-0" href="#main">本文へ移動</a>
    <slot />
    <script>
      import "../scripts/elements";
    </script>
  </body>
</html>
