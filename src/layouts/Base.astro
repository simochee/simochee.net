---
import "../styles/index.css";
import bodyFont from "../assets/fonts/shinonome14-regular-kana.woff2?url";
import Sidebar from "../components/Sidebar.astro";
import { categories, site } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}
const { title, description = site.description, image = "/og.jpg", article, publishedAt, updatedAt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHome = Astro.url.pathname === "/";
const SiteTitle = isHome ? "h1" : "p";
const menu = [
  { href: "/", label: "ホーム" },
  ...Object.entries(categories).map(([type, label]) => ({ href: `/${type}/`, label })),
  { href: "/feed.xml", label: "RSS" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <div class="frame">
      <div class="topline small">
        <span>{site.tagline}</span>
        <a href="/">ブログトップ</a>
      </div>
      <header class="banner">
        <SiteTitle class="site-title"><a href="/">{site.name}</a></SiteTitle>
        <p class="site-description">{site.description}</p>
      </header>
      <nav class="global-nav" aria-label="グローバルメニュー">
        <ul>
          {
            menu.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === Astro.url.pathname ? "page" : undefined}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="columns">
        <main id="main"><slot /></main>
        <aside aria-label="サイドバー"><Sidebar /></aside>
      </div>
      <footer class="site-footer small">Copyright &copy; {site.name} All Rights Reserved.</footer>
    </div>
  </body>
</html>
