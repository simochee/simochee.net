---
import Document, { type Props } from "./Document.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import { site } from "../site";

const isHome = Astro.url.pathname === "/";
const SiteTitle = isHome ? "h1" : "p";
const menu = [
  { href: "/", label: "ホーム" },
  { href: "/archive/", label: "全記事一覧" },
  { href: "/profile/", label: "プロフィール" },
  { href: "/bbs/", label: "掲示板" },
  { href: "/mail/", label: "メールフォーム" },
  { href: "/feed.xml", label: "RSS" },
];
---

<Document {...Astro.props}>
  <div class="mx-auto max-w-800 border border-frame bg-paper">
    <div class="type-small flex flex-wrap justify-between gap-x-12 gap-y-4 border-b border-line bg-wash px-10 py-3" transition:name="topline">
      <span>{site.tagline}</span>
      <span><a href="/">ブログトップ</a> | <a href="/archive/">記事一覧</a> | <a href="/gallery/">画像一覧</a></span>
    </div>
    <header class="border-b-3 border-double border-frame bg-band px-20 pt-30 pb-20" transition:name="banner">
      <SiteTitle class="text-title font-bold"><a class="text-ink-strong no-underline" href="/">{site.name}</a></SiteTitle>
      <p class="mt-6 text-ink-sub">{site.description}</p>
    </header>
    <nav class="bg-accent" aria-label="グローバルメニュー" transition:name="menu">
      <ul class="flex flex-wrap">
        {
          menu.map((item, index) => (
            <li>
              <a
                class:list={[
                  "block px-14 py-5 text-on-accent no-underline hover:text-on-accent hover:underline focus-visible:-outline-offset-3 focus-visible:outline-on-accent aria-[current=page]:bg-menu-current aria-[current=page]:font-bold",
                  index < menu.length - 1 && "border-r border-menu-divider",
                ]}
                href={item.href}
                aria-current={item.href === Astro.url.pathname ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 折り返しの判定を flex に任せている。メディアクエリにすると、サイドバーが下へ回る幅を文字サイズの設定ごとに決め直すことになる。 */}
    <div class="flex flex-wrap gap-20 p-16">
      <main id="main" class="min-w-0 flex-[999_1_520px]" transition:name="main" transition:animate="fade"><slot /></main>
      <aside class="flex min-w-0 flex-[1_1_210px] flex-col gap-16" aria-label="サイドバー" transition:name="sidebar" transition:persist><Sidebar /></aside>
    </div>
    <footer class="type-small border-t border-frame bg-band px-10 py-12 text-center" transition:name="footer">Copyright &copy; {site.name} All Rights Reserved.</footer>
  </div>
</Document>
