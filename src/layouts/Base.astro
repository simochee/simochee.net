---
import { getImage } from "astro:assets";
import avatar from "virtual:avatar";
import { ClientRouter } from "astro:transitions";
import { SIMOCHEE_NOINDEX, WEB_ANALYTICS_TOKEN } from "astro:env/server";
import "../styles/global.css";
import bodyFont from "../assets/fonts/shinonome14-regular-kana.woff2?url";
import Sidebar from "../components/layout/Sidebar.astro";
import ThemeBoot from "../components/layout/ThemeBoot.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  /** 検索に載せないページ。SIMOCHEE_NOINDEX のときは全ページがこうなる。 */
  noindex?: boolean;
}
const { title, description = site.description, image = "/og.jpg", article, publishedAt, updatedAt } = Astro.props;
const noindex = SIMOCHEE_NOINDEX || Astro.props.noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHome = Astro.url.pathname === "/";
const SiteTitle = isHome ? "h1" : "p";
const icons = avatar && {
  favicon: await getImage({ src: avatar, width: 32, height: 32, format: "png" }),
  // iOS はホーム画面のアイコンの透過部分を黒で塗る。Astro の background は透過を持たない形式へ変換するときだけ効くので、JPEG にして白で埋める。
  touch: await getImage({ src: avatar, width: 180, height: 180, format: "jpeg", background: "#fff" }),
};
const menu = [
  { href: "/", label: "ホーム" },
  { href: "/archive/", label: "全記事一覧" },
  { href: "/profile/", label: "プロフィール" },
  { href: "/bbs/", label: "掲示板" },
  { href: "/feed.xml", label: "RSS" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {icons && <link rel="icon" type="image/png" sizes="32x32" href={icons.favicon.src} />}
    {icons && <link rel="apple-touch-icon" sizes="180x180" href={icons.touch.src} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}（最新コメント）`} href="/comments.xml" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {
      WEB_ANALYTICS_TOKEN && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}></script>
      )
    }
    <ThemeBoot />
    <ClientRouter fallback="swap" />
  </head>
  <body class="px-10 pt-14 pb-32 max-sm:p-0">
    <a class="absolute top-0 left-0 -translate-y-[200%] border border-frame bg-paper px-12 py-4 focus:z-10 focus:translate-y-0" href="#main">本文へ移動</a>
    <div class="mx-auto max-w-800 border border-frame bg-paper max-sm:border-0">
      <div class="type-small flex flex-wrap justify-between gap-x-12 gap-y-4 border-b border-line bg-wash px-10 py-3" transition:name="topline">
        <span>{site.tagline}</span>
        <span><a href="/">ブログトップ</a> | <a href="/archive/">記事一覧</a> | <a href="/gallery/">画像一覧</a></span>
      </div>
      <header class="border-b-3 border-double border-frame bg-band px-20 pt-30 pb-20" transition:name="banner">
        <SiteTitle class="text-title font-bold"><a class="text-ink-strong no-underline" href="/">{site.name}</a></SiteTitle>
        <p class="mt-6 text-ink-sub">{site.description}</p>
      </header>
      <nav class="bg-accent" aria-label="グローバルメニュー" transition:name="menu">
        <ul class="flex flex-wrap">
          {
            menu.map((item, index) => (
              <li>
                <a
                  class:list={[
                    "block px-14 py-5 text-on-accent no-underline hover:text-on-accent hover:underline focus-visible:-outline-offset-3 focus-visible:outline-on-accent aria-[current=page]:bg-menu-current aria-[current=page]:font-bold",
                    index < menu.length - 1 && "border-r border-menu-divider",
                  ]}
                  href={item.href}
                  aria-current={item.href === Astro.url.pathname ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* 折り返しの判定を flex に任せている。メディアクエリにすると、サイドバーが下へ回る幅を文字サイズの設定ごとに決め直すことになる。 */}
      {/* 縦に積んだときだけ間から台紙の色を見せたいので、空けるのは行の間（row-gap）だけにして余白は本文とサイドバーの内側に持たせる。
          column-gap を空けると横並びのときに縦の帯まで透ける。 */}
      <div class="flex flex-wrap gap-y-10 bg-page">
        <main id="main" class="min-w-0 flex-[999_1_552px] bg-paper p-16" transition:name="main" transition:animate="fade"><slot /></main>
        <aside class="@container min-w-0 flex-[1_1_230px] bg-paper" aria-label="サイドバー" transition:name="sidebar" transition:persist>
          {/* 横並びでは本文の右余白と合わせて 20px の間隔にするため左を詰め、下に回って全幅になったら左右をそろえる。
              横並びのサイドバーは枠の最大幅 800px から本文の最小幅を引いた 246px より広がらないので、260px を超えたら下に回っている。 */}
          <div class="flex flex-col gap-16 py-16 pr-16 pl-4 @min-[260px]:pl-16"><Sidebar /></div>
        </aside>
      </div>
      <footer class="type-small border-t border-frame bg-band px-10 py-12 text-center" transition:name="footer">Copyright &copy; {site.name} All Rights Reserved.</footer>
    </div>
    <script>
      import "../scripts/elements";
      import "../scripts/landing";
    </script>
  </body>
</html>
