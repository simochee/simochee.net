---
import "../styles/global.css";
import bodyFont from "../assets/fonts/shinonome14-regular-kana.woff2?url";
import Sidebar from "../components/Sidebar.astro";
import ThemeBoot from "../components/ThemeBoot.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}
const { title, description = site.description, image = "/og.jpg", article, publishedAt, updatedAt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHome = Astro.url.pathname === "/";
const SiteTitle = isHome ? "h1" : "p";
const menu = [
  { href: "/", label: "ホーム" },
  { href: "/archive/", label: "全記事一覧" },
  { href: "/profile/", label: "プロフィール" },
  { href: "/feed.xml", label: "RSS" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} - ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <ThemeBoot />
  </head>
  <body class="px-10 pt-14 pb-32">
    <a class="absolute top-0 left-0 -translate-y-[200%] border border-frame bg-paper px-12 py-4 focus:z-10 focus:translate-y-0" href="#main">本文へ移動</a>
    <div class="mx-auto max-w-800 border border-frame bg-paper">
      <div class="type-small flex flex-wrap justify-between gap-x-12 gap-y-4 border-b border-line bg-wash px-10 py-3">
        <span>{site.tagline}</span>
        <span><a href="/">ブログトップ</a> | <a href="/archive/">記事一覧</a></span>
      </div>
      <header class="border-b-3 border-double border-frame bg-band px-20 pt-30 pb-20">
        <SiteTitle class="text-title font-bold"><a class="text-ink-strong no-underline" href="/">{site.name}</a></SiteTitle>
        <p class="mt-6 text-ink-sub">{site.description}</p>
      </header>
      <nav class="bg-accent" aria-label="グローバルメニュー">
        <ul class="flex flex-wrap">
          {
            menu.map((item, index) => (
              <li>
                <a
                  class:list={[
                    "block px-14 py-5 text-on-accent no-underline hover:text-on-accent hover:underline focus-visible:-outline-offset-3 focus-visible:outline-on-accent aria-[current=page]:bg-menu-current aria-[current=page]:font-bold",
                    index < menu.length - 1 && "border-r border-menu-divider",
                  ]}
                  href={item.href}
                  aria-current={item.href === Astro.url.pathname ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* 折り返しの判定を flex に任せている。メディアクエリにすると、サイドバーが下へ回る幅を文字サイズの設定ごとに決め直すことになる。 */}
      <div class="flex flex-wrap gap-20 p-16">
        <main id="main" class="min-w-0 flex-[999_1_520px]"><slot /></main>
        <aside class="flex min-w-0 flex-[1_1_210px] flex-col gap-16" aria-label="サイドバー"><Sidebar /></aside>
      </div>
      <footer class="type-small border-t border-frame bg-band px-10 py-12 text-center">Copyright &copy; {site.name} All Rights Reserved.</footer>
    </div>
  </body>
</html>
