---
import '../styles.css';
interface Props { title: string; description?: string; image?: string; article?: boolean; publishedAt?: Date; updatedAt?: Date }
const { title, description = '技術と日々の記録。', image = '/og.jpg', article, publishedAt, updatedAt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'simochee.net' ? title : `${title} | simochee.net`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="simochee.net" href="/feed.xml" />
    <meta property="og:site_name" content="simochee.net" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
  </head>
  <body>
    <a class="skip" href="#main">本文へ</a>
    <header class="site-header"><a href="/">simochee.net</a><nav aria-label="メイン"><a href="/tech/">技術</a><a href="/personal/">日々</a><a href="/feed.xml">RSS</a></nav></header>
    <main id="main"><slot /></main>
    <footer>© simochee.net</footer>
  </body>
</html>
